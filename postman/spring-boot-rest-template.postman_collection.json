          "name": "Duplicate SKU Conflict (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Returns conflict error payload', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.status).to.eql(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Duplicate SKU Test\",\n  \"description\": \"Run while SKU-001 exists to trigger 409 Conflict\",\n  \"price\": 25.0,\n  \"stockQuantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
