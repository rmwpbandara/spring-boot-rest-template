    {
      "name": "Products (CRUD)",
      "description": "Standard CRUD and partial update endpoints. Run 'Create Product' first to automatically capture {{productId}}.",
      "item": [
        {
          "name": "1. Create Product (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Location header is returned', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "pm.test('Response envelope is valid and saves productId', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.id).to.be.a('number');",
                  "    pm.collectionVariables.set('productId', body.data.id);",
                  "    if (pm.environment.name) {",
                  "        pm.environment.set('productId', body.data.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"Tactile brown switches, compact 75% layout\",\n  \"price\": 89.99,\n  \"stockQuantity\": 25,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Creates a new product and automatically saves the created ID to {{productId}}."
          },
          "response": []
        },
        {
          "name": "2. Get All Products (Paginated & Filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns paginated payload', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.content).to.be.an('array');",
                  "    pm.expect(body.data).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=0&size=10&sortBy=id&sortDir=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "description": "Zero-based page index"
                },
                {
                  "key": "size",
                  "value": "10",
                  "description": "Page size (max 100)"
                },
                {
                  "key": "sortBy",
                  "value": "id",
                  "description": "Allowed: id, sku, name, price, stockQuantity, status, createdAt, updatedAt"
                },
                {
                  "key": "sortDir",
                  "value": "desc",
                  "description": "asc or desc"
                },
                {
                  "key": "search",
                  "value": "Keyboard",
                  "disabled": true,
                  "description": "Optional case-insensitive name search"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "disabled": true,
                  "description": "Optional: ACTIVE, INACTIVE, OUT_OF_STOCK"
                }
              ]
            },
            "description": "Lists products with pagination, sorting, and optional name/status filters."
          },
          "response": []
        },
        {
          "name": "3. Get Product By ID (GET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns matching product', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('productId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Fetches a single product by {{productId}}."
          },
          "response": []
        },
        {
          "name": "4. Update Product - Full Replace (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Product fields updated', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.name).to.eql('Mechanical Keyboard Pro');",
                  "    pm.expect(body.data.price).to.eql(99.99);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard Pro\",\n  \"description\": \"Hot-swappable switches, aluminum frame\",\n  \"price\": 99.99,\n  \"stockQuantity\": 20,\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Replaces all mutable fields of the product."
          },
          "response": []
        },
        {
          "name": "5. Patch Product - Partial Update (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Only provided fields updated', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.price).to.eql(79.5);",
                  "    pm.expect(body.data.status).to.eql('OUT_OF_STOCK');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 79.5,\n  \"status\": \"OUT_OF_STOCK\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Updates only the non-null fields provided in the request payload."
          },
          "response": []
        },
        {
          "name": "6. Delete Product (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Deletes the product identified by {{productId}}."
          },
          "response": []
        }
      ]
